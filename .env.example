# ==============================================================================
# Automated Trading Bot — Environment Configuration
# NEVER commit the .env file to version control.
# ==============================================================================

# ── UPSTOX CREDENTIALS (the only broker account) ──────────────────────────────
# Get these from: https://developer.upstox.com/
UPSTOX_API_KEY=your_upstox_api_key
UPSTOX_API_SECRET=your_upstox_api_secret
UPSTOX_REDIRECT_URI=https://127.0.0.1/
# Run `python3 -m automate.auth.upstox_auth` each morning to refresh this token:
UPSTOX_ACCESS_TOKEN=your_daily_upstox_access_token

# Optional — enables automate.auth.upstox_auto_login's headless daily token
# refresh (Selenium-driven login), so you don't need to run the command
# above manually. SECURITY: TOTP_SECRET is the seed your 2FA app uses to
# generate codes — combined with PIN, this is permanent full login access
# to your real account on disk. Leave all 3 blank to skip auto-login and
# keep doing the manual refresh above instead (equally fine, just manual).
UPSTOX_USERNAME=
UPSTOX_PIN=
UPSTOX_TOTP_SECRET=

# Comma-separated strategy names (strategies/registry.py keys) that
# run_strategy actually executes live. Adding a strategy to the registry
# does NOT make it go live — it must be listed here too (or passed via
# --strategies). See config.STRATEGY_CONFIGS for the matching per-strategy
# symbol/lot config each name needs. Paper vs. live is each strategy's own
# MODE in config.py, not set here — see README's "Paper vs. Live" section.
ACTIVE_STRATEGIES=ten_percent_otm_strangle

# Post-entry risk controls (TAKE_PROFIT_PCT/STOP_LOSS_PCT) are strategy
# config, not global settings — edit them directly in
# config.TenPercentOTMStrangleConfig, same as SYMBOLS/STRIKE_STEPS. See
# README's "Post-Entry Risk Controls" section before enabling: disabled by
# default on purpose, not just an unset placeholder — a longer real-data
# backtest showed the naked strategy winning on total return despite a
# much bigger single worst trade.

# ── DATABASE (MySQL — required) ───────────────────────────────────────────────
# positions/backtest_runs live here now, not a local SQLite file — see
# db/engine.py::DatabaseConfig. The API refuses to start without DB_USER/
# DB_PASSWORD set. Least-privilege: this user only needs SELECT/INSERT/
# UPDATE/DELETE for runtime queries (Alembic migrations use it too, but
# only during deploys).
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=automate

# NOTE: the paper-trading wallet's starting capital is NOT an env var — it's
# a real DB-backed setting (wallet_settings table, see
# db/migrations/versions/0002_wallet_settings.py), editable at runtime from
# the Wallet page / POST /api/wallet/capital, no restart needed. Defaults to
# ₹0 until you set it.

# ── TELEGRAM ALERTS (optional but recommended) ────────────────────────────────
# Alerts fire on: expired/invalid broker token (surfaces as a FATAL/kill
# -switch error), every trade opened, every trade closed, every failed
# entry, and any exit that couldn't be completed (needs manual action).
# Leave blank to disable — the bot runs fine without this, you just won't
# be notified of anything except by reading logs.
# Get BOT_TOKEN from @BotFather on Telegram; get CHAT_ID by messaging your
# bot once, then visiting https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ── MARKET HOURS ──────────────────────────────────────────────────────────────
MARKET_OPEN=09:15:00
MARKET_CLOSE=15:30:00

# ── LOGGING ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/strategy.log

# ── PANEL AUTH (optional — disabled by default) ───────────────────────────────
# Set PANEL_AUTH_ENABLED=true to require login before accessing the control
# panel. When disabled (default), the panel is localhost-only with no auth layer.
# If enabled, set PANEL_JWT_SECRET to a cryptographically random secret:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
# Without this, an ephemeral secret is auto-generated (sessions lost on restart).
PANEL_AUTH_ENABLED=false
PANEL_JWT_SECRET=
PANEL_SESSION_HOURS=8
PANEL_OPEN_REGISTRATION=true

# ── EQUITY STRATEGY (equity_ma_crossover) ────────────────────────────────────
# Comma-separated NSE equity symbols to trade (spot/delivery market).
EQUITY_MA_SYMBOLS=RELIANCE,TCS
# Short-term and long-term MA window sizes in trading days.
EQUITY_MA_SHORT_WINDOW=10
EQUITY_MA_LONG_WINDOW=30
# Number of shares to buy per crossover signal.
EQUITY_NUM_SHARES=1
# Product type: CNC (delivery, hold overnight) or MIS (intraday only).
EQUITY_PRODUCT=CNC
# paper = simulated (no real orders), live = real Upstox orders.
EQUITY_MODE=paper
