[Unit]
Description=Automate control-panel API (FastAPI/uvicorn)
After=network.target

[Service]
Type=simple
User=shubhanshu
WorkingDirectory=/var/www/html/automate
ExecStart=/var/www/html/automate/.venv/bin/python -m uvicorn automate.api.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3
# KillMode=process (not the default control-group): the daemon-control
# routes (api/routes_daemon.py) spawn the trading daemon as a DETACHED
# child of this service via subprocess.Popen(start_new_session=True) —
# that protects it from terminal signals/process-group kills, but NOT
# from systemd's cgroup-wide kill on restart/stop, since child processes
# inherit this service's cgroup regardless of session. KillMode=process
# means only the tracked main PID (uvicorn itself) is killed here, so
# restarting/redeploying the API never takes the trading daemon down
# with it.
KillMode=process
StandardOutput=append:/var/www/html/automate/logs/api.log
StandardError=append:/var/www/html/automate/logs/api.log

[Install]
WantedBy=multi-user.target
